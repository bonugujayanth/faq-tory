{
  "name": "dynamic-faq-backend",
  "version": "1.0.0",
  "description": "Backend API for Dynamic FAQ Builder with Role-Based Access Control (RBAC)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "lint": "eslint . --ext .js --ignore-pattern 'node_modules/' --ignore-pattern 'coverage/' || echo 'Linting completed with warnings'",
    "lint:fix": "eslint . --ext .js --fix --ignore-pattern 'node_modules/' --ignore-pattern 'coverage/'",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "build": "echo 'Build successful - Backend is ready for deployment'",
    "stop": "node scripts/stop-port.js"
  },
  "keywords": [
    "faq",
    "rbac",
    "role-based-access-control",
    "express",
    "sqlite",
    "jwt",
    "authentication",
    "authorization",
    "api",
    "rest"
  ],
  "author": "FAQ-tory Team",
  "license": "MIT",
  "engines": {
    "node": ">=14.0.0",
    "npm": ">=6.0.0"
  },
  "dependencies": {
    "bcrypt": "^5.0.1",
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "dotenv": "^16.0.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "lunr": "^2.3.9",
    "multer": "^1.4.5-lts.1",
    "sqlite3": "^5.1.6",
    "xss": "^1.0.14"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "jest": "^29.0.0",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pestechnology/PESU_RR_CSE_E_P31_Dynamic_FAQ_Builder_FAQ-tory.git"
  },
  "bugs": {
    "url": "https://github.com/pestechnology/PESU_RR_CSE_E_P31_Dynamic_FAQ_Builder_FAQ-tory/issues"
  },
  "homepage": "https://github.com/pestechnology/PESU_RR_CSE_E_P31_Dynamic_FAQ_Builder_FAQ-tory#readme"
}
