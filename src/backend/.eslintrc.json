{
  "root": true,
  "env": {
    "node": true,
    "es2021": true,
    "jest": true
  },
  "parserOptions": {
    "ecmaVersion": 2021,
    "sourceType": "script"
  },
  "extends": "eslint:recommended",
  "rules": {
    "curly": "off",
    "brace-style": "off",
    "space-before-function-paren": "off",
    "quotes": "off",
    "indent": "off",
    "no-console": "off",
    "comma-dangle": "off",
    "eqeqeq": "off",
    "no-empty": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }]
  }
}
